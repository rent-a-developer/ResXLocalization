<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <config>
    <!-- An isolated package cache: the freshly packed version must never collide with (or pollute)
         the machine-wide cache. Delete this folder to pick up a re-packed build locally;
         scripts/verify-package-aot.ps1 deletes it on every run. -->
    <add key="globalPackagesFolder" value=".packages" />
  </config>
  <packageSources>
    <clear />
    <!-- The packages under test, produced by `dotnet pack ... -o artifacts/packages`. -->
    <add key="local-packages" value="../../artifacts/packages" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <packageSourceMapping>
    <!-- ResXLocalization.* comes from the local feed and from nowhere else. Without this mapping a
         missing local package resolves from nuget.org instead, where a published package of the same
         version exists - and the consumption checks would then pass against the last release rather
         than against what was just packed. Every other dependency, including Avalonia, comes from
         nuget.org as usual. -->
    <packageSource key="local-packages">
      <package pattern="ResXLocalization.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
