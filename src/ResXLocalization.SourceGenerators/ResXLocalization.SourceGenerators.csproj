<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <IsRoslynComponent>true</IsRoslynComponent>
    <!-- Roslyn source generators must target netstandard2.0 so the compiler can load them. -->
    <TargetFramework>netstandard2.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <!-- The compiler floor this generator is built against is set for this project in
         Directory.Packages.props, with the reason. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="AnalyzerReleases.Shipped.md" />
    <AdditionalFiles Include="AnalyzerReleases.Unshipped.md" />
  </ItemGroup>

  <!-- This is a build-time analyzer (netstandard2.0), never published or AOT-compiled. When the
       consuming app runs `dotnet publish /p:PublishAot=true`, that global property flows into this
       project's build and trips NETSDK1207. Reassigning it inside a target overrides the global
       property (target-time assignments win), so framework-reference resolution sees PublishAot=false. -->
  <Target Name="_DisableAotForAnalyzer" BeforeTargets="ProcessFrameworkReferences">
    <PropertyGroup>
      <PublishAot>false</PublishAot>
      <PublishTrimmed>false</PublishTrimmed>
      <SelfContained>false</SelfContained>
      <!-- The consumer's publish also passes /p:IsAotCompatible=true as a global property, which flows
           in here and (with the IsTrimmable it derives) trips NETSDK1210/NETSDK1212 on netstandard2.0.
           Neutralize the AOT and trimming switches the same way. -->
      <IsAotCompatible>false</IsAotCompatible>
      <EnableAotAnalyzer>false</EnableAotAnalyzer>
      <IsTrimmable>false</IsTrimmable>
      <EnableTrimAnalyzer>false</EnableTrimAnalyzer>
    </PropertyGroup>
  </Target>

</Project>
