<UserControl x:Class="RentADeveloper.ResXLocalization.WPF.Benchmarks.Views.TranslationSourceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:RentADeveloper.ResXLocalization.WPF;assembly=ResXLocalization.WPF"
             xmlns:shared="clr-namespace:RentADeveloper.ResXLocalization.Benchmarks">
    <StackPanel>
        <TextBlock Text="{Binding [Title], Source={x:Static shared:TranslationSource.Instance}}" />
        <TextBlock Text="{Binding [Save], Source={x:Static shared:TranslationSource.Instance}}" />
        <TextBlock Text="{Binding [Cancel], Source={x:Static shared:TranslationSource.Instance}}" />
        <TextBlock Text="{Binding [Open], Source={x:Static shared:TranslationSource.Instance}}" />
        <TextBlock Text="{Binding [Close], Source={x:Static shared:TranslationSource.Instance}}" />
        <TextBlock Text="{Binding [Delete], Source={x:Static shared:TranslationSource.Instance}}" />
        <TextBlock Text="{Binding [UserMessages], Source={x:Static shared:TranslationSource.Instance}}" />
        <TextBlock Text="{Binding [Enum_Priority_Priority1], Source={x:Static shared:TranslationSource.Instance}}" />
        <TextBlock Text="{Binding [Enum_Priority_Priority2], Source={x:Static shared:TranslationSource.Instance}}" />
        <TextBlock Text="{Binding [Enum_Priority_Priority3], Source={x:Static shared:TranslationSource.Instance}}" />
    </StackPanel>
</UserControl>
