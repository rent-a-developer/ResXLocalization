<UserControl x:Class="RentADeveloper.ResXLocalization.Avalonia.Benchmarks.Views.StaticView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:RentADeveloper.ResXLocalization.Avalonia;assembly=ResXLocalization.Avalonia"
             xmlns:shared="clr-namespace:RentADeveloper.ResXLocalization.Benchmarks">
    <StackPanel>
        <TextBlock Text="{x:Static shared:BenchmarkStrings.Title}" />
        <TextBlock Text="{x:Static shared:BenchmarkStrings.Save}" />
        <TextBlock Text="{x:Static shared:BenchmarkStrings.Cancel}" />
        <TextBlock Text="{x:Static shared:BenchmarkStrings.Open}" />
        <TextBlock Text="{x:Static shared:BenchmarkStrings.Close}" />
        <TextBlock Text="{x:Static shared:BenchmarkStrings.Delete}" />
        <TextBlock Text="{x:Static shared:BenchmarkStrings.UserMessages}" />
        <TextBlock Text="{x:Static shared:BenchmarkStrings.Enum_Priority_Priority1}" />
        <TextBlock Text="{x:Static shared:BenchmarkStrings.Enum_Priority_Priority2}" />
        <TextBlock Text="{x:Static shared:BenchmarkStrings.Enum_Priority_Priority3}" />
    </StackPanel>
</UserControl>
